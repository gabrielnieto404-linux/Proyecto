<?php
$rawdata = file_get_contents('php://input');
$data = json_decode($rawdata, true);

if (isset($data['lat']) && isset($data['lon'])) {
    $lat = $data['lat'];
    $lon = $data['lon'];
    $acc = $data['acc'];
    $fecha = date("Y-m-d H:i:s");

    // Formato para guardar en un bloc de notas
    $resultado = "Fecha: $fecha | Latitud: $lat | Longitud: $lon | Precisión: $acc metros\n";
    file_put_contents("ubicaciones.txt", $resultado, FILE_APPEND);

    echo "Ubicación guardada con éxito";
} else {
    echo "No se recibieron datos.";
}
?>


