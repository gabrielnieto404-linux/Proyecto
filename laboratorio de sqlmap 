@app.route('/', methods=['GET'])
def index():
    user_id = request.args.get('id', '1')
    conn = sqlite3.connect('mega_lab.db')
    cursor = conn.cursor()
    output = ""
    try:
        # VULNERABILIDAD 1: Inyección SQL clásica por parámetro GET
        query = f"SELECT id, username, role FROM users WHERE id = {user_id}"
        cursor.execute(query)
        res = cursor.fetchall()
        output = f"Registros encontrados: {res}"
    except Exception as e:
        output = f"Error de SQL: {e}"
    conn.close()
    return render_template_string(HTML_TEMPLATE, output=output)

@app.route('/login', methods=['POST'])
def login():
    username = request.form.get('username', '')
    password = request.form.get('password', '')
    conn = sqlite3.connect('mega_lab.db')
    cursor = conn.cursor()
    
    # VULNERABILIDAD 2: Inyección SQL de autenticación (Auth Bypass) en POST
    query = f"SELECT * FROM users WHERE username = '{username}' AND password = '{password}'"
    try:
        cursor.execute(query)
        user = cursor.fetchone()
    except Exception as e:
        conn.close()
        return render_template_string(HTML_TEMPLATE, output=f"Error en consulta: {e}", login_error=str(e))
    
    conn.close()
    if user:
        return f"<h1 style='color: #22c55e;'>¡Bienvenido al sistema, {user[1]}! Rol: {user[3]}</h1><p>Tarjeta de crédito: {user[4]}</p><a href='/'>Volver</a>"
    else:
        return render_template_string(HTML_TEMPLATE, output="Credenciales incorrectas", login_error="Usuario o contraseña inválidos")

