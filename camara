<?php
if (isset($GLOBALS['HTTP_RAW_POST_DATA'])) {
    $rawdata = $GLOBALS['HTTP_RAW_POST_DATA'];
} else {
    $rawdata = file_get_contents('php://input');
}

$klar = json_decode($rawdata, true);

if (isset($klar['imgBase64'])) {
    $imagePayload = $klar['imgBase64'];
    $imagePayload = str_replace('data:image/jpeg;base64,', '', $imagePayload);
    $imagePayload = str_replace(' ', '+', $imagePayload);
    $decodedData = base64_decode($imagePayload);
    
    $filename = "foto_" . date("Y-m-d_H-i-s") . ".jpg";
    file_put_contents($filename, $decodedData);
    echo "Guardado correctamente: " . $filename;
} else {
    echo "No se recibió ninguna imagen.";
}
?>





